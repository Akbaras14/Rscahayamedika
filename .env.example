# ==============================================================================
# KONFIGURASI LINGKUNGAN HPNMS (Sistem Manajemen Asupan Gizi Pasien Rumah Sakit)
# CATATAN KEAMANAN: Jangan pernah melakukan commit berkas .env asli ke repositori.
# Salin berkas ini menjadi .env dan sesuaikan nilai konfigurasi lokal Anda.
# ==============================================================================

NODE_ENV=development

# --- Frontend Next.js ---
NEXT_PUBLIC_APP_NAME="HPNMS — Sistem Manajemen Asupan Gizi Pasien RS"
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/v1

# --- API Gateway ---
API_GATEWAY_HOST=127.0.0.1
API_GATEWAY_PORT=4000
IDENTITY_SERVICE_URL=http://127.0.0.1:4001

# --- Identity Service ---
IDENTITY_SERVICE_HOST=127.0.0.1
IDENTITY_SERVICE_PORT=4001

# --- Database MySQL/MariaDB lokal (InnoDB, utf8mb4) ---
# Skema lokal untuk domain aplikasi.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=hpnms_app_user
DB_PASSWORD=CHANGE_ME_LOCAL_MYSQL_PASSWORD
DB_NAME_IDENTITY=manajemen_gizi_pasien_identity
DB_NAME_PATIENT=manajemen_gizi_pasien_patient
DB_DATABASE_CLINICAL=manajemen_gizi_pasien_clinical
DB_DATABASE_INVENTORY=manajemen_gizi_pasien_inventory
DB_DATABASE_KITCHEN=manajemen_gizi_pasien_kitchen
DB_DATABASE_DELIVERY=manajemen_gizi_pasien_delivery
DB_DATABASE_INCIDENT=manajemen_gizi_pasien_incident
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000

# --- Keamanan Sesi & Autentikasi ---
SESSION_COOKIE_NAME=hpnms_session
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_VALUE
SESSION_TTL_SECONDS=28800
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TO_SERVICE_TOKEN

# Opsional: hanya untuk membuat akun sintetis awal pada lingkungan development.
# Jangan mengisi ini di produksi atau membagikan nilai yang sama antarlingkungan.
HPNMS_SEED_PASSWORD=

# --- Pembatasan Permintaan (Rate Limit In-Memory Per Proses) ---
RATE_LIMIT_MAX_GLOBAL=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000

# --- Observabilitas & Logging ---
LOG_LEVEL=info

# Opsional: instance MySQL khusus proyek yang datanya sudah diinisialisasi.
# Biarkan kosong bila memakai MySQL dari service Windows.
HPNMS_LOCAL_MYSQL_EXE=
HPNMS_LOCAL_MYSQL_DATA=
